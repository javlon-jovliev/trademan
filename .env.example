DATABASE_URL=postgresql://erta:change-me@localhost:5432/erta
DEMO_MODE=true
APP_ORIGIN=http://localhost:3000
SEED_USERNAME=admin
SEED_EMAIL=admin@example.test
# Required: choose a strong initial password. No built-in password.
SEED_PASSWORD=
IBKR_GATEWAY_URL=https://localhost:5000/v1/api
IBKR_ACCOUNT_ID=
# Trust the gateway certificate through NODE_EXTRA_CA_CERTS, never disable TLS verification.
TELEGRAM_BOT_TOKEN=
WORKER_INTERVAL_MS=60000

# Required for automatic closed-trade history (Activity Flex XML query in UTC)
IBKR_FLEX_TOKEN=
IBKR_FLEX_QUERY_ID=
POSTGRES_PASSWORD=

# Explicit adapter: web (existing default) or tws. No automatic failover.
IBKR_ADAPTER=web
IBKR_TWS_BRIDGE_URL=http://127.0.0.1:8000
# Generate a random token, minimum 32 characters. Never use IBKR login credentials here.
IBKR_TWS_BRIDGE_TOKEN=
IBKR_TWS_HOST=host.docker.internal
# IB Gateway paper: 4002, live: 4001. TWS paper: 7497, live: 7496.
IBKR_TWS_PORT=4002
IBKR_TWS_CLIENT_ID=71
