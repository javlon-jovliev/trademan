{
  "name": "erta",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "next build --webpack",
    "start": "next start --hostname 0.0.0.0",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:seed": "tsx prisma/seed.ts",
    "worker": "tsx scripts/worker.ts",
    "local:db": "tsx scripts/local-db.ts",
    "local:pglite": "tsx --env-file=.env scripts/pglite-db.ts",
    "test:api": "playwright test tests/e2e/api.spec.ts",
    "format": "prettier --write app components server broker risk notifications i18n scripts tests"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.0.0",
    "@prisma/client": "6.19.0",
    "@radix-ui/react-dialog": "^1.1.23",
    "@tanstack/react-table": "^8.21.0",
    "argon2": "^0.44.0",
    "dotenv": "^17.0.0",
    "fast-xml-parser": "^5.11.2",
    "lightweight-charts": "^5.0.0",
    "lucide-react": "^0.468.0",
    "next": "^16.0.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-hook-form": "^7.0.0",
    "recharts": "^3.0.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@electric-sql/pglite-socket": "^0.2.11",
    "@playwright/test": "^1.56.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "embedded-postgres": "^18.0.0-beta.15",
    "eslint": "^9.0.0",
    "eslint-config-next": "^16.0.0",
    "prettier": "^3.9.9",
    "prisma": "6.19.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vitest": "^3.2.0"
  }
