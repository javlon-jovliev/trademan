# Copy to .env.production at repository root; chmod 600 .env.production.
# Do not commit the populated file. Use URL-safe random DB password characters.
POSTGRES_PASSWORD=
DEMO_MODE=false
APP_ORIGIN=https://trademan.example.com
SEED_USERNAME=admin
SEED_EMAIL=admin@example.test
SEED_PASSWORD=
IBKR_ADAPTER=tws
IBKR_ACCOUNT_ID=
IBKR_TWS_BRIDGE_TOKEN=
IBKR_TWS_HOST=host.docker.internal
IBKR_TWS_PORT=4002
IBKR_TWS_CLIENT_ID=71
IBKR_TWS_BRIDGE_URL=http://tws-bridge:8000
# Optional when explicitly switching back to Web API:
IBKR_GATEWAY_URL=
NODE_EXTRA_CA_CERTS=
IBKR_FLEX_TOKEN=
IBKR_FLEX_QUERY_ID=
TELEGRAM_BOT_TOKEN=
WORKER_INTERVAL_MS=60000
